{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "src/utils/**/*.js",
    "src/middleware/**/*.js",
    "src/routes/routeGates.js",
    "src/database/testRunLock.js",
    "src/database/restoreBaseline.js"
  ]
}