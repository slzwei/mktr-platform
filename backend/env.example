# =============================================================================
# MKTR Platform — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:  cp env.example .env
# Do NOT commit .env to version control.
#
# Only NODE_ENV, PORT, JWT_SECRET and the DB_* block are needed to boot. Every
# integration below is optional and inert unless its vars are set — the core
# lead-capture flow works without any of them.
#
# Frontend (VITE_*) vars live in ../.env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Set to "true" behind a reverse proxy (Nginx, Cloudflare, Render, etc.)
TRUST_PROXY=false
# Pino level. Default: "info" in production, "debug" otherwise.
# LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — PostgreSQL (REQUIRED)
# -----------------------------------------------------------------------------
# There is no SQLite fallback: connection.js throws on boot if DB_HOST is unset.
# For a local instance: docker compose up -d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mktr_db
DB_USER=mktr_user
DB_PASSWORD=mktr_password
# Force SSL on/off (auto-enabled in production if omitted)
# DB_SSL=true
# PEM CA bundle for managed providers that require one
# DB_CA_CERT=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Local-dev seeding (npm run seed) — the script refuses to run in production
# or against a non-local DB_HOST. No defaults: unset = the seeder aborts.
# SEED_ADMIN_PASSWORD=
# Optional second account; the agent row is only seeded when this is set.
# SEED_AGENT_PASSWORD=
# Optional email overrides (defaults: admin@local.test / agent@local.test).
# SEED_ADMIN_EMAIL=
# SEED_AGENT_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-json-file
# Explicit redirect URI (optional — derived from FRONTEND_BASE_URL if omitted)
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# External JWT verification via JWKS (middleware/auth.js). Only for fronting the
# monolith with an external identity provider — unused in the normal setup.
# All three must be set together.
# AUTH_JWKS_URL=
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# ⚠️ SECURITY-SENSITIVE. When "true", a JWKS-verified token whose email matches
# no local account AUTO-CREATES a new customer user with emailVerified: true —
# i.e. anyone your external IdP will issue a token for silently becomes a user
# here. Leave off unless you operate a trusted IdP AND want that provisioning;
# envValidation.js warns loudly at boot when it is enabled. (Only meaningful
# when AUTH_JWKS_URL is set; consider deleting the code path if you never
# federate — middleware/auth.js mapJwtToUser.)
# ENABLE_AUTH_MAPPING=false

# -----------------------------------------------------------------------------
# AI providers (Campaign Studio fill, guided review, cadence drafts)
# -----------------------------------------------------------------------------
# Master secret used to AES-256-GCM encrypt admin-entered AI API keys at rest.
# REQUIRED before admins can save keys in AdminAISettings. >= 32 random chars.
AI_SETTINGS_ENCRYPTION_KEY=
# Optional server-managed fallbacks. Admin-entered keys take precedence.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# URLs & hosts
# -----------------------------------------------------------------------------
# Frontend origin for invite links, admin emails, OAuth callback
FRONTEND_BASE_URL=http://localhost:5173
# Public host baked into generated QR images (must serve /t/:slug).
# Prod: https://redeem.sg — per-campaign mktr QRs use MKTR_FRONTEND_URL instead.
PUBLIC_BASE_URL=http://localhost:3001
# Per-brand bases: trackerController + leadCaptureBind redirect users back to the
# SPA on the same public host they arrived on.
MKTR_FRONTEND_URL=https://mktr.sg
REDEEM_FRONTEND_URL=https://redeem.sg
# CORS allowlist (comma-separated). The four apex+www hosts are already defaults.
CORS_ORIGIN=http://localhost:5173,https://mktr.sg,https://www.mktr.sg,https://redeem.sg,https://www.redeem.sg
# Public API origin baked into unsubscribe links (default https://api.mktr.sg)
API_PUBLIC_ORIGIN=

# -----------------------------------------------------------------------------
# Branding (email templates)
# -----------------------------------------------------------------------------
COMPANY_NAME=MKTR
COMPANY_URL=https://mktr.sg

# -----------------------------------------------------------------------------
# Email (SMTP via Nodemailer)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Default From address (falls back to EMAIL_USER)
# EMAIL_FROM=noreply@example.com
# Per-brand senders — mailer.resolveEmailFrom(context) picks by the campaign's
# design_config.customerHost. EMAIL_FROM_MKTR is first in the resolution chain,
# so set it explicitly or agent/admin mail goes out as the SMTP login.
EMAIL_FROM_MKTR=noreply@mktr.sg
EMAIL_FROM_REDEEM=noreply@redeem.sg
# Where homepage waitlist signups are announced (has a hardcoded default —
# set this so it isn't a personal inbox).
WAITLIST_NOTIFY_EMAIL=

# Email broadcast push (cohort marketing mail)
# Send rate ceiling, messages/second
# EMAIL_BROADCAST_RATE_PER_SEC=5
# Refuse to start a broadcast larger than this
# EMAIL_BROADCAST_MAX_RECIPIENTS=5000

# -----------------------------------------------------------------------------
# Consent ledger / unsubscribe
# -----------------------------------------------------------------------------
# Dedicated unsubscribe-token secret. Optional — falls back to JWT_SECRET with a
# context salt. Rotating whichever is in use invalidates outstanding links.
UNSUB_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# OTP / phone verification
# -----------------------------------------------------------------------------
# SMS via AWS SNS is the default channel. WhatsApp OTP (Meta) is optional and
# used only for campaigns whose design_config.otpChannel='whatsapp'; if the Meta
# vars are missing or a send fails, it falls back to SMS.

# AWS SNS — SMS delivery. Shared pair (also carries SES); prefer the scoped pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# REQUIRED for +65 SG: must be the SSIR-registered ID (case-sensitive) or SG
# telcos relabel the sender "Likely-SCAM". Code defaults to "MKTR".
AWS_SNS_SENDER_ID=MKTR

# Least-privilege SNS-only IAM user. Set BOTH or NEITHER — a half-set pair is
# ignored and the shared AWS_* pair is used, because mixing a new key id with an
# old secret fails every publish.
SNS_AWS_ACCESS_KEY_ID=
SNS_AWS_SECRET_ACCESS_KEY=

# SMS abuse controls (SGNIC SSIR User Agreement cl. 2.3.2). POST /api/verify/send
# is public and unauthenticated, and every message carries the registered "MKTR"
# sender ID — these caps are what stop it being used as an SMS bomber. Both are
# per Singapore calendar day. Runbook: docs/reference/sms-sender-id-compliance.md
SMS_DAILY_CAP_PER_PHONE=7
SMS_DAILY_GLOBAL_CAP=500
SMS_DAILY_ALERT_THRESHOLD=250
# Where volume alerts are emailed. Unset = structured log only.
SMS_ALERT_EMAIL=
# Optional HMAC salt blinding phone numbers in counter keys so rate_counters
# holds no PII (falls back to JWT_SECRET).
SMS_QUOTA_SALT=

# -----------------------------------------------------------------------------
# WhatsApp — OTP channel (Meta WhatsApp Cloud API)
# -----------------------------------------------------------------------------
# NOTE: these META_WA_* credentials are SEPARATE from the WHATSAPP_* pair further
# down. This set drives OTP; that set drives Redeem Ops reward/draw sends.
#
# There is no provider switch: the channel is chosen PER CAMPAIGN by
# design_config.otpChannel ('sms' | 'whatsapp'), and a failed WhatsApp send
# falls back to SMS.
# From WhatsApp Manager → API setup. Requires an APPROVED Authentication
# template (default 'auth_otp', language 'en_US') with an OTP button.
# P4-2 sender unification: the OTP path reads THIS legacy pair FIRST (in prod
# it is a deliberately separate sender number whose statuses the webhook
# skips), falling back to the unified WHATSAPP_TOKEN/WHATSAPP_PHONE_NUMBER_ID
# family below when unset. Existing deploys need NO changes; a fresh install
# may set only the WHATSAPP_* pair for both OTP and reward delivery.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
# Optional overrides (code defaults shown)
# META_WA_TEMPLATE_NAME=auth_otp
# META_WA_TEMPLATE_LANG=en_US
# Shared across every Meta Graph call (CAPI, WA, audiences)
# META_GRAPH_API_VERSION=v23.0   (single source for EVERY Graph call — client default is v23.0)

# -----------------------------------------------------------------------------
# WhatsApp — Redeem Ops reward / draw sends
# -----------------------------------------------------------------------------
# Consumer-facing template sends (voucher, reward pass, draw entry pass, boost
# receipt). Ships dark: with the flag on but creds missing, every reward send
# fails as a notify_failed receipt — silence for the customer.
REDEEM_OPS_WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Language code applied to every template send (default 'en')
# WHATSAPP_TEMPLATE_LANG=en
# Origin used in claim links inside messages (default https://redeem.sg)
# WHATSAPP_CLAIM_ORIGIN=https://redeem.sg
# Send the voucher QR as an image header (default true; "false" = text only)
# WHATSAPP_QR_HEADER=true
# Approved template NAMES — override only if renamed in WhatsApp Manager.
# Every WHATSAPP_TEMPLATE_* below takes a template name, never true/false: the
# value goes to Meta verbatim as template.name, so "true" makes every send on
# that rail fail with 132001 (template not found). Only WHATSAPP_QR_HEADER
# above is a boolean. Confirm the name AND its category first with:
#   pbpaste | node backend/scripts/submit-wa-marketing-templates.mjs --all --token-stdin
# MARKETING templates are accepted (HTTP 200) and then silently dropped under
# Meta's per-user frequency cap (131049) — the whole reason the _v2 pair exists.
# WHATSAPP_TEMPLATE_PASS=reward_pass
# WHATSAPP_TEMPLATE_VOUCHER=reward_voucher_v2
# Draw entry pass — UTILITY, 4 params (name, draw, pass link, boost deadline)
# WHATSAPP_TEMPLATE_DRAW_PASS=draw_entry_pass
# Draw ×N boost receipt — UTILITY, 3 params whose ORDER follows the body, which
# is keyed by name in whatsappService (re-read the live body before adding one):
#   draw_boost_receipt, draw_session_receipt → (name, draw, chances)
#   draw_boost_receipt_v2 and newer          → (name, chances, draw)
# WHATSAPP_TEMPLATE_DRAW_BOOST=draw_boost_receipt_v2
# Screening callback opt-in — MARKETING, 4 params; URL button = consent tap
# WHATSAPP_TEMPLATE_DRAW_CALLBACK=draw_callback_optin

# -----------------------------------------------------------------------------
# WhatsApp — delivery-status webhook (docs/plans/wa-delivery-truth.md)
# -----------------------------------------------------------------------------
# POST /api/whatsapp/webhook records sent/delivered/read/failed per wamid —
# including the silent 131049 marketing-frequency-cap drops — and honors STOP
# replies as the global unsubscribe.
# Subscription handshake token (any random string; must match what you give Meta).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret (App Dashboard → Settings → Basic) for X-Hub-Signature-256.
# PRODUCTION FAILS CLOSED without it: the webhook answers 200 but drops every payload.
WHATSAPP_APP_SECRET=
# Pin callbacks to our WABA (entries for other WABAs are ignored).
WHATSAPP_WABA_ID=

# -----------------------------------------------------------------------------
# Object storage — S3-compatible (DigitalOcean Spaces)
# -----------------------------------------------------------------------------
# All five of KEY/SECRET/REGION/ENDPOINT/BUCKET are required to enable remote
# storage; otherwise uploads fall back to local disk under backend/uploads/.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_CDN_BASE=

# Max upload size in MEGABYTES for /api/uploads/* (default: 10). When
# overriding, also set VITE_MAX_UPLOAD_SIZE_MB on every frontend build so the
# editor's copy matches the enforcement point.
# MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# Attribution & tracking secrets (REQUIRED in production)
# -----------------------------------------------------------------------------
# HMAC secret for attribution cookie signatures
ATTRIB_SECRET=
# Salt for hashing visitor IPs
IP_HASH_SALT=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# -----------------------------------------------------------------------------
# System defaults
# -----------------------------------------------------------------------------
SYSTEM_AGENT_EMAIL=system@mktr.local
# Redirect System Agent lead-assignment emails here (skipped if unset)
# SYSTEM_AGENT_REDIRECT_EMAIL=admin@example.com
# Pin a default active agent id; if invalid, email fallback is used
# DEFAULT_AGENT_ID=
# Fallback creator for admin-created lead packages when no actor is resolvable
# ADMIN_PACKAGES_CREATOR_USER_ID=

# =============================================================================
# Lead pipeline (Retell → MKTR → Lyfe / mktr-leads)
# =============================================================================

# -----------------------------------------------------------------------------
# Retell AI — capture bot (post-call webhook)
# -----------------------------------------------------------------------------
# HMAC secret verifying inbound Retell webhooks (scheme: hmac(body + timestamp))
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret
# API key for fetching call recordings
RETELL_API_KEY=your-retell-api-key
# JSON array — auto-creates [Retell] campaigns on startup.
# Format: [{"agentId":"agent_xxx","name":"Campaign Name"}]
RETELL_AGENTS=[]
# Optional: override campaign resolution per agent — retellAgentId:campaignUUID,...
# RETELL_CAMPAIGN_MAP=

# -----------------------------------------------------------------------------
# Retell AI — screening-call gate (docs/plans/retell-screening-calls.md)
# -----------------------------------------------------------------------------
# Dark unless enabled. Campaigns opt in via Studio (form.gates.screeningCall);
# qualified leads release to the agent, negatives hold in the admin queue.
# Flipping the kill switch off drains pending unscreened leads.
RETELL_SCREENING_ENABLED=false
# RETELL_SCREENING_AGENT_ID=agent_xxxxxxxxxxxx
# The number screening calls originate from. ALSO printed on the draw success
# page ("an automated call from … will ring you shortly"), so it must be the
# real caller ID — one env var feeds both.
# RETELL_SCREENING_FROM_NUMBER=+6562773210
# Seconds between signup and the FIRST dial (0 = dial immediately, max 900).
# Default 60 so the consumer can read the success page before the phone rings.
# SCREENING_DIAL_DELAY_SECONDS=60
# SCREENING_MAX_ATTEMPTS=3
# SCREENING_RETRY_MINUTES=120
# SCREENING_CALL_WINDOW=10:00-20:00
# SCREENING_MAX_CONCURRENT=3
# SCREENING_MAX_DIALS_PER_DAY=50
# SCREENING_STALE_CALL_MINUTES=30
# SCREENING_MAX_HOLD_HOURS=24
# SCREENING_ON_UNREACHABLE=release
# SCREENING_SWEEP_INTERVAL_MINUTES=5
# SCREENING_DRY_RUN=false
# Ops email for "qualified lead stuck — no deliverable agent" alerts (throttled
# 1/campaign/24h). Falls back to SMS_ALERT_EMAIL when unset.
# SCREENING_ALERT_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# Lead quota / held queue
# -----------------------------------------------------------------------------
# Email the admin queue when a lead is held for want of a funded agent.
# HELD_LEAD_PING_ENABLED=false

# -----------------------------------------------------------------------------
# Webhook dispatch → Lyfe
# -----------------------------------------------------------------------------
# Master switch — MUST be "true" for leads to reach any downstream app.
WEBHOOK_ENABLED=false
# Edge function URL for receive-mktr-lead
LYFE_WEBHOOK_URL=https://<project>.supabase.co/functions/v1/receive-mktr-lead
# Shared HMAC secret (must match MKTR_WEBHOOK_SECRET in the Supabase edge fn)
LYFE_WEBHOOK_SECRET=your-shared-webhook-secret
# REVERSE channel: Lyfe leads-outcome trigger → POST
# /api/integrations/lyfe/lead-outcome (fires down-funnel Meta CAPI events).
# Must match MKTR_LEAD_OUTCOME_SECRET in the Lyfe Supabase Vault.
LYFE_LEAD_OUTCOME_SECRET=your-lead-outcome-webhook-secret
# Lyfe users push webhook → POST /api/integrations/lyfe/users-webhook, which
# closes the 10-minute agent-sync lag on activations/deactivations.
LYFE_USERS_WEBHOOK_SECRET=

# lead.suppressed propagation — per-destination opt-in.
# DANGER: flip ONLY after that consumer's handler is DEPLOYED. The receivers 400
# unknown events, and 50 consecutive failures auto-disable the subscriber,
# stopping ALL lead delivery to that app.
# Runbook: docs/reference/webhook-propagation-contract.md
LYFE_LEAD_SUPPRESSED_ENABLED=false
MKTR_LEADS_LEAD_SUPPRESSED_ENABLED=false

# -----------------------------------------------------------------------------
# Lyfe Supabase (agent sync)
# -----------------------------------------------------------------------------
LYFE_SUPABASE_URL=https://<project>.supabase.co
# Service-role key (bypasses RLS — keep secret)
LYFE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: PostgREST URL for mirroring web-lead timeline activities into Lyfe.
# Unset = the timeline mirror is skipped entirely.
# SUPABASE_LEAD_ACTIVITIES_URL=

# -----------------------------------------------------------------------------
# mktr-leads (second agent source — mirrored into `users` exactly like Lyfe)
# -----------------------------------------------------------------------------
# All OPTIONAL: leave unset and mktr-leads is fully inert (no sync, no
# subscriber). Agent sync is env-gated on MKTR_LEADS_SUPABASE_URL; the outbound
# subscriber on the WEBHOOK_URL/SECRET pair.
MKTR_LEADS_SUPABASE_URL=https://<project>.supabase.co
MKTR_LEADS_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MKTR_LEADS_WEBHOOK_URL=https://<project>.supabase.co/functions/v1/receive-mktr-lead
MKTR_LEADS_WEBHOOK_SECRET=your-shared-webhook-secret
# Admin invites via the mktr-leads create-ext-agent-invite edge fn (must match
# its MKTR_PLATFORM_INVITE_SECRET function secret)
MKTR_LEADS_INVITE_SECRET=your-invite-service-secret

# -----------------------------------------------------------------------------
# External broker surfaces (/api/external/* — called BY mktr-leads)
# -----------------------------------------------------------------------------
# Shared HMAC secret authenticating the agent- and admin-facing broker routes
# (packages, held leads, lead activities, wallet, billing).
EXTERNAL_APP_SECRET=
# Separate secret for the inbound lead-outcome channel from mktr-leads.
EXTERNAL_OUTCOME_WEBHOOK_SECRET=
# Route flags — each surface stays UNMOUNTED until its flag is "true".
AGENT_PACKAGES_EXTERNAL_ENABLED=false
ADMIN_PACKAGES_EXTERNAL_ENABLED=false
ADMIN_LEAD_OPS_EXTERNAL_ENABLED=false
HELD_LEADS_EXTERNAL_ENABLED=false
LEAD_TIMELINE_EXTERNAL_ENABLED=false

# =============================================================================
# Campaigns, marketplace & draws
# =============================================================================

# Campaign Studio emergency brake. design_config v2 writes are REJECTED unless
# this is "true" — the Studio's save path depends on it.
DESIGN_CONFIG_V2_WRITES_ENABLED=false

# Public marketplace listing API (/api/marketplace)
MARKETPLACE_PUBLIC_API_ENABLED=false
# Listings + featured tiles derive from the campaign page instead of being
# authored twice. Flip together with VITE_MARKETPLACE_INHERIT_ENABLED.
MARKETPLACE_INHERIT_ENABLED=false
# Route /t/:slug QR scans into the marketplace offer page rather than straight
# to lead capture.
MARKETPLACE_QR_REDIRECT_ENABLED=false

# Draw ×N boost rail auto-provisioning: launching a draw campaign creates or
# adopts its reward rail automatically; the sweep tops allocations up under 20%
# remaining. Kill switch defaults ON.
# DRAW_BOOST_AUTOPROVISION_ENABLED=true
# DRAW_BOOST_DEFAULT_ALLOCATION=10000
# Draw ENGINE-RECORD auto-creation: launching a draw campaign (or the boot /
# hourly reconciler, for campaigns already live) creates the draws row that the
# chances display and freeze/seal run on. Replaces the manual
# run-lucky-draw.js create step. Kill switch defaults ON.
# DRAW_RECORD_AUTOCREATE_ENABLED=true
# House partner owning auto-provisioned review offers (falls back to the
# MKTR PTE. LTD. partner row by legalName).
# REDEEM_HOUSE_PARTNER_ORG_ID=

# =============================================================================
# Ads & conversion tracking
# =============================================================================

# -----------------------------------------------------------------------------
# Meta Conversions API (outbound server-side events)
# -----------------------------------------------------------------------------
# Master switch — "true" to dispatch Lead events to Meta
META_CAPI_ENABLED=false
# Pixel ID from Meta Business Manager → Events Manager (15-16 digits)
META_PIXEL_ID=
# Access token from Pixel → Settings → Conversions API. Saved once; if lost,
# regenerate (the old token then stops working).
META_CAPI_ACCESS_TOKEN=
# Test Event code from Pixel → Test Events. Staging only; empty in production.
META_TEST_EVENT_CODE=
# Down-funnel event names fired when a Lyfe agent advances a lead. `qualified`
# means the agent CONFIRMED Singapore Citizen/PR (the liar-proof version of the
# self-declared form gate) → ConfirmedResident. `won` (bought a policy) →
# ConfirmedResident if not already, plus ClosedWon. Override only if you rename
# the events in Events Manager.
META_EVENT_QUALIFIED=ConfirmedResident
META_EVENT_WON=ClosedWon
# Fired when a voucher is BURNED at the partner counter (action_source=
# physical_store) — the strongest signal in the funnel: only a physically
# present person redeems.
META_EVENT_REDEEMED=VoucherRedeemed

# -----------------------------------------------------------------------------
# Meta customer-list "redeemed" exclusion sync
# -----------------------------------------------------------------------------
# Pushes redeemers (hashed email+phone) into a Customer-List (subtype=CUSTOM)
# audience used as an ad-set EXCLUSION, so people who already redeemed stop
# seeing ads.
REDEEMED_AUDIENCE_SYNC_ENABLED=false
# System User token with ads_management on the ad account (NOT the CAPI token).
META_ADS_MANAGEMENT_TOKEN=
# Target Customer-List audience id.
META_REDEEMED_AUDIENCE_ID=
# Ad account id (numeric, no act_ prefix). NOT read by the server — recorded
# here because creating the audience or running a permission probe by hand
# needs it. The sync itself is audience-scoped.
META_AD_ACCOUNT_ID=

# ── Meta Lead Ads native ingestion (docs/plans/meta-lead-ads-native-pipe.md) ──
# Master flag. With it "true" in production, boot FAILS unless the three
# secrets below are present (envValidation.js) — the flag arms a public
# lead-bearing webhook, so partial config must never half-run.
META_LEAD_ADS_ENABLED=false
# App secret of the Meta app that owns the leadgen webhook subscription —
# verifies X-Hub-Signature-256 on POST /api/meta/webhook.
META_APP_SECRET=
# Shared phrase you invent, pasted into the Meta app dashboard's webhook
# setup; answers the GET hub.challenge handshake.
META_VERIFY_TOKEN=
# 32-byte key (64-char hex or exactly-32-char string) sealing page access
# tokens at rest in meta_pages (AES-256-GCM). Rotating it requires re-saving
# every stored page token via POST /api/meta/pages.
META_PAGE_TOKEN_ENC_KEY=
# Optional single-page fallback used ONLY while no meta_pages row exists for
# this exact page id — set BOTH or NEITHER (boot-enforced pair).
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# ── Connect Facebook — agent self-serve OAuth (docs/plans/facebook-connect-self-serve.md) ──
# Requires META_LEAD_ADS_ENABLED=true. With this "true" in production, boot
# FAILS unless META_APP_ID, FB_LOGIN_CONFIG_ID, META_AGENT_ADS_CAMPAIGN_ID and
# EXTERNAL_APP_SECRET are all present.
META_OAUTH_ENABLED=false
# App ID of the same Meta app that owns META_APP_SECRET.
META_APP_ID=
# Facebook Login for Business configuration id (app dashboard → Facebook
# Login for Business → Configurations).
FB_LOGIN_CONFIG_ID=
# Campaign every self-serve agent's leads route into. Must be active with
# quota OFF and no leadPriceCents (agents pay with their own ad spend) —
# bootstrap re-arms drift and refuses to boot if the campaign is missing.
META_AGENT_ADS_CAMPAIGN_ID=
# Bare https origin serving /api/meta/oauth/callback (defaults to
# https://api.mktr.sg). Must exactly match the Valid OAuth Redirect URI in
# the Meta app dashboard.
# META_OAUTH_CALLBACK_ORIGIN=
# Browser completion page (defaults to https://redeem.sg/fb-connected).
# META_OAUTH_COMPLETION_URL=
# "add" (additive POST /users — default, verified) or "replace" (POST
# /usersreplace — authoritative full replace; probe before relying on it).
REDEEMED_AUDIENCE_SYNC_MODE=add
# Consent gate: default true (upload only prospects with consent_contact=true).
# Setting "false" suppresses ALL redeemers — a legal/DPIA decision, not an eng one.
REDEEMED_AUDIENCE_REQUIRE_CONSENT=true
# In-process cadence: first run ~60s after boot, then every N hours.
REDEEMED_AUDIENCE_SYNC_INTERVAL_HOURS=24
# Email for "bad run" alerts. Unset = log + Sentry only.
REDEEMED_AUDIENCE_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# TikTok Events API (outbound server-side events)
# -----------------------------------------------------------------------------
TIKTOK_EVENTS_API_ENABLED=false
# Pixel code from TikTok Events Manager. Campaign.tiktokPixelId overrides this.
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
# Staging only; empty in production.
TIKTOK_TEST_EVENT_CODE=

# =============================================================================
# Redeem Ops (partner CRM — ops.redeem.sg)
# =============================================================================

# Master switch — the /api/redeem-ops/* routes stay UNMOUNTED until "true".
REDEEM_OPS_ENABLED=false
# Fulfilment phase: registers the lead-capture entitlement hook, mounts the
# public /api/reward-claim + consultant unlock surfaces, schedules the
# expiry/reconciliation sweep. Requires REDEEM_OPS_ENABLED too.
REDEEM_OPS_ENTITLEMENTS_ENABLED=false

# ── Outreach cadences (sequencing engine; migration 057) ──────────────────────
# Routes + hook wiring + seeds + reconcile tick (needs REDEEM_OPS_ENABLED too)
REDEEM_OPS_CADENCES_ENABLED=false
# Max live enrollments per owner (managers may override per-enroll)
REDEEM_OPS_CADENCE_CAP=60
# AI cadence drafts in the editor (needs a provider key in AdminAISettings or
# OPENAI_API_KEY / ANTHROPIC_API_KEY)
REDEEM_OPS_CADENCES_AI_ENABLED=false

# ── Cadence email auto-send (Phase A: personas + Workspace directory;
#    migration 119; docs/plans/redeem-ops-cadence-email-autosend.md) ─────────
# Settings card + persona/workspace-address routes (needs REDEEM_OPS_ENABLED).
# Phase A never emails a prospect — test-send goes to the account's own inbox.
REDEEM_OPS_EMAIL_AUTOSEND_ENABLED=false
# Encrypts the pasted Google service-account key (own key — NEVER reuse
# AI_SETTINGS_ENCRYPTION_KEY; rotating one must not brick the other). ≥32 chars.
OUTREACH_MAILBOX_ENCRYPTION_KEY=
# Approval ramp: the first N auto-sends of each cadence version hold for a
# one-tap human approval before the version runs unattended (Phase B).
REDEEM_OPS_AUTOSEND_APPROVAL_RAMP=10

# ── Discover tool (Apify prospecting; migration 053) ──────────────────────────
DISCOVERY_ENABLED=false                       # master switch (also gates the reconcile sweep)
DISCOVERY_IG_ENABLED=false                    # Instagram hashtag-discovery pilot (Maps stays primary)
DISCOVERY_SEARCH_TERMS_ENABLED=false          # expand category aliases in Maps searches
DISCOVERY_RESULT_QUOTA_ENABLED=false          # atomic result/profile counters; off = run-count quotas
DISCOVERY_AI_TERMS_ENABLED=false              # AI keyword suggestions (provider key required)
APIFY_TOKEN=                                  # SECRET — Apify API token
APIFY_MAPS_ACTOR_ID=compass~crawler-google-places                 # Google Maps scraper
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-profile-scraper          # IG enrichment (PROFILE scraper — takes `usernames`)
APIFY_INSTAGRAM_HASHTAG_ACTOR_ID=apify~instagram-hashtag-scraper  # IG hashtag DISCOVERY (`hashtags` + `resultsLimit`)
DISCOVERY_WEBHOOK_SECRET=                     # URL-path secret for the Apify terminal-event callback
DISCOVERY_WEBHOOK_BASE_URL=https://api.mktr.sg  # public base for the callback URL
DISCOVERY_MAX_RESULTS_PER_RUN=500             # per-search depth cap; 500 ≈ a whole-SG sweep of a dense category (~$3.50)
DISCOVERY_MAX_RUNS_PER_DAY=25                 # global daily cap
DISCOVERY_MAX_RUNS_PER_USER_DAY=5             # per-user cap (cost guardrail — access is all-principals)
DISCOVERY_ENRICH_MAX_PER_DAY=500              # team cap for IG enrichment, in PROFILES/day
DISCOVERY_ENRICH_MAX_PER_USER_DAY=200         # per-user profile cap
DISCOVERY_RESULTS_PER_USER_DAY=1500           # atomic per-user SGT-day result reservation cap
DISCOVERY_RESULTS_PER_TEAM_DAY=6000           # advisory team SGT-day result cap
DISCOVERY_PROFILES_PER_USER_DAY=200           # atomic per-user SGT-day IG profile cap
DISCOVERY_PROFILES_PER_TEAM_DAY=500           # advisory team SGT-day IG profile cap
DISCOVERY_COST_PER_RESULT_USD=0.007           # rough pre-run estimate; actual read from the run
DISCOVERY_RECONCILE_STUCK_MINUTES=10          # age before a non-terminal run is re-fetched from Apify
DISCOVERY_CANDIDATE_TTL_DAYS=90               # retention: purge scraped candidates after N days (0 = forever)

# =============================================================================
# Money — agent wallet & billing
# =============================================================================

# Lead-package billing (HitPay) — DEPLOY-INERT until BILLING_ENABLED=true
BILLING_ENABLED=false
# App-Store kill switch surfaced on the catalog: in_app | web | off
BILLING_CHECKOUT_MODE=in_app
HITPAY_API_KEY=                                 # secret
HITPAY_WEBHOOK_SALT=                            # secret — webhook signature key
HITPAY_API_BASE=https://api.hit-pay.com/v1      # sandbox: https://api.sandbox.hit-pay.com/v1
HITPAY_PAYMENT_METHODS=paynow_online,card
HITPAY_WEBHOOK_URL=                             # full URL to /api/external/billing/hitpay-webhook (optional if dashboard-configured)
HITPAY_REDIRECT_URL=                            # app deep link back after pay (optional; the webhook is source of truth)

# Agent wallet + per-campaign commitments — DEPLOY-INERT until
# AGENT_WALLET_ENABLED=true (docs/plans/agent-wallet-commitments.md). Gates
# /api/external/wallet. Top-ups ride /api/external/billing (kind:'wallet_topup'),
# so BILLING_ENABLED must also be true for money-in. Admin endpoints
# (/api/admin/wallets) are always mounted — admin-authed reads + audited adjustment.
AGENT_WALLET_ENABLED=false

# =============================================================================
# DNC Registry (Singapore PDPC "Do Not Call") scrubbing
# =============================================================================
# See docs/plans/dnc-scrubbing.md. All OPTIONAL; unset/false = inert.
# Master switch — must be "true" to make any DNC API call.
DNC_API_ENABLED=false
# UAT: https://uat.dnc.gov.sg/realtime   Prod: https://www.dnc.gov.sg/realtime
DNC_BASE_URL=https://uat.dnc.gov.sg/realtime
# Assigned by PDPC after org-account onboarding.
DNC_ORG_CODE=
DNC_ESERVICE_ID=
# RSA private key (PEM) matching the X.509 cert submitted to PDPC. SECRET —
# never commit. A literal "\n" in the value is auto-restored to real newlines.
DNC_PRIVATE_KEY=
# "Y" to check on behalf of another org (changes onboarding); default "N".
DNC_CHECK_ON_BEHALF=N
# Fixed-IP egress proxy for the DNC call (PDPC allowlists its IP).
# See docs/dnc/egress-proxy-runbook.md.
# DNC_HTTPS_PROXY=http://user:pass@dnc-egress-host:8888
# block = withhold DNC-registered leads; flag = deliver with a Do-Not-Call flag.
DNC_ENFORCEMENT=block
# Background re-scrub / retry job (recovers dnc_pending leads that errored).
DNC_BACKFILL_ENABLED=false
DNC_BACKFILL_INTERVAL_MINUTES=30
# ── Declared but NOT YET READ BY ANY CODE ────────────────────────────────────
# Both are part of the DNC design that has not been implemented. Setting them
# changes nothing today; they are kept so the intent survives.
# Allow recorded consent to override a DNC hit (must be evidence-backed).
DNC_CONSENT_OVERRIDES=false
# Re-check this many days before a result's validity expires.
DNC_REVALIDATE_DAYS=5
# Per-call timeout (ms).
DNC_TIMEOUT_MS=5000
# Hourly credit budget — safety cap below EVERY paid DNC call.
DNC_HOURLY_BUDGET=1000
# In-process cache TTL for a phone's DNC verdict (ms).
# DNC_CHECK_CACHE_TTL_MS=
# How long an OTP-verified phone marker stays trusted for DNC purposes (ms).
# DNC_VERIFIED_MARKER_TTL_MS=
# How long the durable phone-verification stamp (phone_verification_markers row)
# counts as "current" for screening/verification checks (ms; default 24h).
# PHONE_VERIFICATION_DURABLE_TTL_MS=86400000

# =============================================================================
# Observability & scheduled jobs
# =============================================================================
SENTRY_DSN=
# Trace/profile sample rate (0–1)
# OBS_SAMPLE_RATE=
# Periodic agent sync every 10 min (Lyfe, then mktr-leads when configured).
# Set "false" for ad-hoc deploy debugging.
SYNC_AGENT_CRON=true

# =============================================================================
# Retired — DOOH / fleet subsystem (2026-07-15)
# =============================================================================
# The tablet routes themselves were DELETED in the P2 teardown (2026-08-01), so
# the old MANIFEST/BEACONS/PROVISIONING/APK_ENABLED flags no longer exist. Only
# these four knobs are still read (asset signing + an RPS config block):
MANIFEST_REFRESH_SECONDS=300
MANIFEST_RPS_PER_DEVICE=2
BEACON_IDEMP_WINDOW_MIN=10
BEACON_RPS_PER_DEVICE=5
# Mounts domain-namespaced route mirrors (/api/leadgen/*, /api/adtech/*,
# /api/admin/*, /api/fleet/*) — a leftover of the abandoned microservices split.
ENABLE_DOMAIN_PREFIXES=false

# -----------------------------------------------------------------------------
# Consumer enrichment (docs/plans/consumer-profile-enrichment.md)
# -----------------------------------------------------------------------------
# Artifact-scoped map jobs (PR 0/1). Flip only AFTER the deploy carrying
# migration 092 has fully rolled — old instances cannot process the new shape.
ENRICHMENT_MAP_ARTIFACT_JOBS=false
# MEET × BUY scoring sweep (PR 2). Off = the sweep is never scheduled and no
# score is ever written; the ledger keeps filling either way. Flip after
# migration 093 lands (it seeds scoring config v1). Restart to take effect.
ENRICHMENT_SCORING_ENABLED=false
# Per-campaign scoring-config admin API (Phase 4, PR D) — mounts
# /api/admin/scoring-configs. Off = the router is never mounted and every path
# 404s. These endpoints author the weights that score every lead, and /propose
# spends money at an AI provider, so it is dark until deliberately flipped.
# Nothing here can make a config LIVE except the explicit approve call: an AI
# proposal lands as a draft, which the resolver cannot see.
SCORING_CONFIG_ADMIN_ENABLED=false

# =============================================================================
# CLI scripts only (not read by the server)
# =============================================================================
# App id for the WhatsApp template-submission script's sample upload; falls back
# to debug_token. See backend/scripts/submit-wa-marketing-templates.mjs.
# WHATSAPP_APP_ID=
