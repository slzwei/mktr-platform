# Node / build
node_modules/
build/
dist/
*.log

# Env and secrets
.env
backend/.env
.env.*
# ...but the committed template must stay trackable — `.env.*` above would
# otherwise shadow it, so a delete-and-re-add would silently fail to stage.
!.env.example

# OS / editor
.DS_Store
*.swp

# SQLite databases
backend/*.db
backend/**/*.db
*.db
*.db-shm
*.db-wal
*.db-journal

# Uploads
backend/uploads/

# Coverage / test
coverage/
.junit/

# Credentials / service-account keys (never commit)
*-[0-9a-f]*.json
*service-account*.json
*credentials*.json
*-private-key*.json

# Claude Code runtime artifacts (commands/ is tracked; lock files are transient)
.claude/*.lock


dist-parity/
dist-studio-smoke/
dist-mktr/

# Review remediation dashboard (scaffolding — see .review/README.md, task P5-1)
.review/
