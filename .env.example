# =============================================================================
# MKTR Platform — Frontend (Vite) Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:  cp .env.example .env
# All variables MUST start with VITE_ to be exposed to the browser.
# Do NOT commit .env to version control.
#
# These are BUILD-TIME values baked into dist/ — changing one in Render requires
# a redeploy, not a restart. Nothing here is a secret: assume every value is
# readable in page source.
#
# Backend vars live in backend/env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Which surface this build is
# -----------------------------------------------------------------------------
# One SPA builds into three Render static sites. See README.md.
#
#   mktr.sg        VITE_BRAND=mktr    (operator console — the default)
#   redeem.sg      VITE_BRAND=redeem  (customer marketplace + lead capture)
#   ops.redeem.sg  VITE_SURFACE=ops   (Redeem Ops staff)
#
# VITE_BRAND selects src/lib/brandConfigs/{mktr,redeem}.js via the @brand-config
# alias, so the inactive brand's strings are tree-shaken out of the bundle.
VITE_BRAND=mktr
# Set to "ops" to build the ops.redeem.sg route table instead of the normal one
# (auth + /redeem-ops/* only; everything else redirects into the queue).
# VITE_SURFACE=

# Backend API base (no trailing slash).
# Prod: https://api.mktr.sg/api on mktr.sg; /api on redeem.sg and ops.redeem.sg,
# where Render rewrites /api/* through to the backend so cookies stay first-party.
VITE_API_URL=http://localhost:3001/api

# Google OAuth client ID (must match the backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Switchboard admin v2 — swaps the SAME admin URLs onto the v2 screens, so
# bookmarks survive. Un-rebuilt routes keep their legacy pages.
VITE_ADMIN_V2_ENABLED=false

# Campaign launch workspace as the campaign entry point (tabs for details /
# design / distribution) instead of the classic edit form.
VITE_CAMPAIGN_WORKSPACE_ENABLED=false

# Marketplace v2 on the redeem build — takes over the apex `/` plus /explore,
# /offers/:slug, /c/:id, /flow/:slug and the static pages. No effect on mktr.
VITE_REDEEM_MARKETPLACE_ENABLED=false
# Marketplace listings + featured tiles derive from the campaign page instead of
# being authored twice. Flip together with the backend MARKETPLACE_INHERIT_ENABLED.
VITE_MARKETPLACE_INHERIT_ENABLED=false

# Redeem Ops internal surface. Gates the /redeem-ops/* route group + nav.
# Backend counterpart: REDEEM_OPS_ENABLED.
VITE_REDEEM_OPS_ENABLED=false
# Cadence authoring inside Redeem Ops. Backend: REDEEM_OPS_CADENCES_ENABLED.
VITE_REDEEM_OPS_CADENCES_ENABLED=false
# Discover tool (Apify prospecting) inside Redeem Ops. It has no capability
# gate, so this build flag is what keeps the nav item + route dark.
# Backend counterpart: DISCOVERY_ENABLED (+ APIFY_TOKEN).
VITE_DISCOVERY_ENABLED=false

# Campaign Studio is PERMANENT — its rollout flag was removed in the teardown PR
# and the route is always registered. Studio saves are governed only by the
# backend DESIGN_CONFIG_V2_WRITES_ENABLED gate.

# -----------------------------------------------------------------------------
# Cross-surface links
# -----------------------------------------------------------------------------
# Where Redeem Ops staff are sent to sign in (default https://ops.redeem.sg).
# VITE_OPS_ORIGIN=https://ops.redeem.sg

# -----------------------------------------------------------------------------
# Tracking pixels (public IDs — embedded in page source, not secrets)
# -----------------------------------------------------------------------------
# Meta Pixel ID from Events Manager. The loader is gated on this being set.
VITE_META_PIXEL_ID=
# Test Event code from Pixel → Test Events. Staging only; empty in production.
VITE_META_TEST_EVENT_CODE=

# TikTok Pixel code from TikTok Events Manager. Loader gated on this.
VITE_TIKTOK_PIXEL_ID=
# Staging only; empty in production.
VITE_TIKTOK_TEST_EVENT_CODE=

# Google Ads account-level conversion ID, format AW-XXXXXXXXX (Google Ads →
# Goals → Conversions → the conversion action's tag setup). Loader gated on this.
VITE_GOOGLE_ADS_CONVERSION_ID=
# Conversion ACTION label that pairs with the ID above — the second half of
# gtag's `send_to`, shown next to the ID on the same tag-setup screen. A
# conversion fired without it is discarded by Google, so BOTH must be set.
VITE_GOOGLE_ADS_LEAD_LABEL=
# Google has no test-event-code equivalent, so dev firing needs an explicit
# opt-in. Any non-empty value enables it. Staging only; empty in production.
VITE_GOOGLE_ADS_DEV_MODE=
# Enhanced Conversions: "true" attaches the submitter's plain email/phone to
# the conversion via gtag('set','user_data') — the tag hashes them before
# transmission. Requires the account-side Enhanced Conversions setting to be
# on for the conversion action. Any other value ships dark.
VITE_GOOGLE_ADS_EC_ENABLED=

# AdRoll retargeting pixel — BOTH ids come off the Manual connection screen
# (AdRoll → Getting Started → Pixel). The loader is gated on both being set,
# so a build with only one stays dark. Customer brand only: set these on the
# redeem-frontend service and leave them EMPTY on mktr-platform (operator UI)
# and redeem-ops-frontend (staff surface).
VITE_ADROLL_ADV_ID=
VITE_ADROLL_PIX_ID=
# AdRoll has no test-event-code equivalent, so dev firing needs an explicit
# opt-in. Any non-empty value enables it. Staging only; empty in production.
VITE_ADROLL_DEV_MODE=

# -----------------------------------------------------------------------------
# Per-build page chrome & SEO (substituted into index.html)
# -----------------------------------------------------------------------------
# vite.config.js supplies brand-aware defaults for all four — override only to
# deviate from the active brand's config.
# VITE_PAGE_TITLE=
# VITE_META_DESCRIPTION=
# VITE_FAVICON_SRC=
# VITE_CANONICAL_BASE=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Sentry error tracking (optional)
VITE_SENTRY_DSN=

# Google Maps embed key — used by the retired fleet/device map screens only.
# VITE_GOOGLE_MAPS_API_KEY=

# Upload-size hint shown in the campaign editor (MEGABYTES). Presentation only —
# the backend's MAX_UPLOAD_SIZE_MB stays the enforcement point. Keep the two in
# sync when overriding (default: 10 on both sides).
# VITE_MAX_UPLOAD_SIZE_MB=10
